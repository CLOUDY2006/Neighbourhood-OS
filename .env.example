VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret
DATABASE_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true

PORT=8787
REQUIRE_EMAIL_CONFIRMED=false
PLATFORM_ADMINS=
CORS_ORIGIN=
CONTACT_EMAIL=you@example.com

# AI is optional. Leave AI_API_KEY empty to use the built-in rule-based fallbacks.
# AI_PROVIDER: gemini (default), groq, anthropic, or openai (any OpenAI-compatible service; needs AI_BASE_URL and AI_MODEL).
AI_PROVIDER=gemini
AI_API_KEY=
# Model names change often. If the server log shows HTTP 404 for the model, copy the current name from your provider's console.
AI_MODEL=
AI_BASE_URL=
AI_VISION=
# Older setting, still works on its own: ANTHROPIC_API_KEY=

CAP_FEEDS=
PUBLIC_URL=http://localhost:5173

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SMTP_URL=
SMTP_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=